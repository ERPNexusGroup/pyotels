# OtelMS API - Configuración de entorno
# Copia este archivo a .env y completa los valores

# ============================================================
# APP
# ============================================================
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1

# ============================================================
# API SECURITY
# ============================================================
API_KEY=changeme-secure-api-key-here
API_KEY_HEADER=X-API-Key

# API_KEY_REQUIRED=false: deshabilita la verificación de API Key en la API.
# Útil para pruebas locales sin claves válidas. NO usar en producción.
API_KEY_REQUIRED=true

# JWT (para auth avanzada futura)
JWT_SECRET_KEY=changeme-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================
# DATABASE
# ============================================================
# SQLite (dev) - archivo local
DATABASE_URL=sqlite+aiosqlite:///./otelms.db

# PostgreSQL (prod) - descomenta y configura para producción
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/otelms

# Pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================
# REDIS (Cache + Celery Broker)
# ============================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=0.5

# ============================================================
# CELERY (Background Tasks)
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=300
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ============================================================
# SCRAPING - OTELMS
# ============================================================
OTELMS_BASE_DOMAIN=otelms.com
OTELMS_LOGIN_PATH=/login/DoLogIn/
OTELMS_CALENDAR_PATH=/reservation_c2/calendar
OTELMS_DETAIL_PATH=/reservation_c2/folio/
OTELMS_GUEST_PATH=/reservation_c2/guestfolio/
OTELMS_EDIT_PATH=/reservation_c2/edit/

# Hotel por defecto y credenciales (sobrescribir por hotel en BD/admin)
OTELMS_DEFAULT_HOTEL_ID=18330
OTELMS_DEFAULT_USERNAME=gerencia@harmonyhotelgroup.com
OTELMS_DEFAULT_PASSWORD=changeme

# Comportamiento del scraper (HTTP/httpx por defecto; browser bajo demanda)
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=60000
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
SCRAPER_SELECTOR_TIMEOUT_MS=20000
SCRAPER_WAIT_AFTER_NAVIGATION_MS=500
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_BASE_DELAY=1.0
SCRAPER_RETRY_MAX_DELAY=30.0
SCRAPER_RETRY_JITTER=true

# Rate limiting (token bucket)
SCRAPER_RATE_LIMIT_REQUESTS_PER_MINUTE=30
SCRAPER_RATE_LIMIT_BURST=5
SCRAPER_RATE_LIMIT_PER_HOTEL=true

# Browser pool (solo si se requiere scraping con navegador)
BROWSER_POOL_SIZE=2
BROWSER_POOL_MAX_IDLE_SECONDS=300
BROWSER_HEADLESS=true

# Cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=1800
CACHE_MAX_SIZE_MB=100

# ============================================================
# API GATEWAY / FEATURE FLAGS (Fase 1 vs Fase 2)
# ============================================================
API_ENABLE_READ_PUBLIC=true
API_ENABLE_INTERNAL_SYNC=true
API_ENABLE_WRITE_ACTIONS=false
API_ENABLE_ADMIN_ROUTES=true
API_ENABLE_LEGACY_ROUTES=false

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | console
LOG_FILE=logs/otelms.log
LOG_ROTATION=1 day
LOG_RETENTION=7 days
LOG_COMPRESSION=gz

# ============================================================
# OBSERVABILITY (opcional, deshabilitado por defecto)
# ============================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
OTEL_ENABLED=false
# OTEL_SERVICE_NAME=otelms-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_HEADERS=

# ============================================================
# SYNC SCHEDULE (Celery Beat)
# ============================================================
SYNC_CALENDAR_CRON=*/15 * * * *    # Cada 15 minutos
SYNC_FULL_DETAIL_CRON=0 3 * * *    # Diario a las 3 AM

# ============================================================
# PROXIES / SCRAPING AVANZADO (opcional, comentado por defecto)
# ============================================================
# USE_PROXY=false
# PROXY_BACKEND=scrape_do           # none | tor | scrape_do | webshare
# PROXY_URL=socks5h://host.docker.internal:9050
# SCRAPER_API_KEY=
