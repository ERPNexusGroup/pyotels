# Dockerfile para Worker (Celery + Scraping con Camoufox)
FROM python:3.12-slim-bookworm AS base

# Instalar dependencias del sistema + Firefox para Camoufox
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libnss3 \
    libnspr4 \
    libdbus-1-3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# Crear usuario no-root
RUN groupadd -r appuser && useradd -r -g appuser -m -d /home/appuser appuser

# Directorio de trabajo
WORKDIR /app

# Instalar uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Copiar archivos de dependencias Y código fuente (necesario para build con src layout)
COPY pyproject.toml uv.lock ./
COPY src/ ./src/

# Instalar dependencias de producción
RUN uv pip install --system --no-cache .

# Instalar Camoufox y descargar binario de Firefox (solo en worker)
RUN uv pip install --system --no-cache "camoufox>=0.5.4" "playwright>=1.50.0" "redbeat" && \
    python -m camoufox fetch

# Cambiar a usuario no-root
USER appuser

# Variables de entorno
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CAMOUFOX_HEADLESS=1 \
    PATH="/home/appuser/.local/bin:${PATH}"

# Health check (verificar que Celery worker está vivo y conectado a Redis)
HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
    CMD celery -A otelms.tasks.celery_app inspect ping -d celery@$HOSTNAME --timeout=10 || exit 1

# Comando por defecto - Celery worker
CMD ["celery", "-A", "otelms.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=2"]