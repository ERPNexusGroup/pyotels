# Variables SOLO para staging (fase de pruebas).
# Se cargan con: --env-file .env --env-file docker/staging.env
# (el segundo archivo prevalece; el .env real conserva sus secretos).
#
# Puertos remapeados: 5433 y 6380 están ocupados por otros proyectos locales.
OTELMS_PG_PORT=5435
OTELMS_REDIS_PORT=6381
